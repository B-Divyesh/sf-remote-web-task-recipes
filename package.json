{
  "name": "remote-web-task-recipes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "build:extension": "wxt build",
    "build:site": "vite build --config site/vite.config.ts",
    "package:extension": "wxt zip && node scripts/copy-extension.mjs",
    "build": "npm run build:extension && npm run build:site && npm run package:extension",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.6"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.11"
  }
}
