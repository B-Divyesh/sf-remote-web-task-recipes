{
  "name": "remote-web-task-recipes",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "prepare:wxt": "wxt prepare",
    "prebuild:site:assets": "npm run prepare:wxt",
    "build:extension": "wxt build",
    "build:site:assets": "vite build --config site/vite.config.ts",
    "build:site": "npm run build:site:assets && npm run build:extension && npm run package:extension",
    "package:extension": "wxt zip && node scripts/copy-extension.mjs",
    "build": "npm run build:site",
    "test": "npm run prepare:wxt && vitest run",
    "test:browser": "npm run build:extension && playwright test",
    "test:site": "npm run build:site && playwright test -c playwright.site.config.ts",
    "test:claims": "npm run build:site:assets && playwright test -c playwright.site.config.ts",
    "check": "npm run prepare:wxt && tsc --noEmit",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/chrome": "^0.1.0",
    "axe-core": "4.11.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.11"
  }
}
